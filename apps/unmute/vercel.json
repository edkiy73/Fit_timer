{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && node scripts/web-layout.mjs",
  "outputDirectory": "dist",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/ai",
      "destination": "/api/admin?ai_endpoint=1"
    },
    {
      "source": "/api/config",
      "destination": "/api/admin?public_config=1"
    },
    {
      "source": "/app/:path+",
      "destination": "/:path+"
    }
  ]
}
