{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@appbase/core/*": ["../../packages/core/src/core/*"],
      "@appbase/types/*": ["../../packages/core/src/types/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
