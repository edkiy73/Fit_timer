# FetUre: one domain for the site and the API (src/api-url.ts). HTTPS from Let's Encrypt, renewed by Caddy.
{
	email {$ACME_EMAIL}
}

{$FETURE_DOMAIN} {
	# Realtime signals stream (SSE): never compressed — a compressor holds bytes back and signals would arrive late.
	@compressible not path /api/fe-events
	encode @compressible zstd gzip

	# Uploads stream through /api/fe-upload (a 100 MB clip at most); every other request is small.
	@upload path /api/fe-upload
	request_body @upload {
		max_size 120MB
	}
	# Commands and sign-in are small JSON (the handler's own cap is 16 KB): nothing bigger is read into memory before auth
	# (security audit 06.11.2026, B3). Admin and document publishing keep a roomier limit.
	@json path /api/fe /api/auth /api/fe-events
	request_body @json {
		max_size 64KB
	}
	@rest not path /api/fe-upload /api/fe /api/auth /api/fe-events
	request_body @rest {
		max_size 1MB
	}

	reverse_proxy app:3000 {
		# Core's rate limits read the first X-Forwarded-For entry. Caddy sets it to the real client and drops a
		# client-sent one (no trusted_proxies here) — keep it that way; do not add a CDN in front of the API.
		header_up -X-Vercel-Ip-Country
		# Stream every byte at once (SSE); ordinary responses are unaffected.
		flush_interval -1
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}

	# Security audit 06.11.2026 (B7). The CSP is report-only first: the browser console shows what it would block; enforce it
	# once a pass over every screen is clean. frame-ancestors/X-Frame-Options already forbid framing (clickjacking).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.b-cdn.net; media-src 'self' blob: https://*.b-cdn.net; connect-src 'self' https://*.b-cdn.net https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}

# The landing page on the bare domain (apps/feture/landing, served as files: a push to main updates it, no rebuild).
# Needs DNS A records for the domain and www → this server; until they exist Caddy just keeps retrying the certificate,
# the app above is unaffected.
{$FETURE_LANDING_DOMAIN}, www.{$FETURE_LANDING_DOMAIN} {
	encode zstd gzip
	root * /srv/landing
	file_server
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Cache-Control "public, max-age=300"
		-Server
	}
}
