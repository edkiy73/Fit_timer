<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET"/>
  <!-- микрофон нужен голосовому управлению на тренировке; TWA запрашивает его сам -->
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <uses-feature android:name="android.hardware.microphone" android:required="false"/>
  <uses-feature android:name="android.hardware.camera" android:required="false"/>

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:supportsRtl="false"
      android:allowBackup="true"
      android:theme="@style/Theme.App">

    <!-- Trusted Web Activity: тот же самый PWA, но без браузерной обвязки.
         Проверка связи домена и приложения идёт через .well-known/assetlinks.json
         на сайте: там лежит отпечаток ключа, которым подписан этот APK. -->
    <activity
        android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
        android:exported="true"
        android:label="@string/app_name">

      <meta-data
          android:name="android.support.customtabs.trusted.DEFAULT_URL"
          android:value="${defaultUrl}"/>
      <!-- Цвета системных полос. appBackground разведён по values/values-night,
           поэтому верхняя полоса и splash подхватывают тему системы, а не один
           зашитый тёмный цвет. Нижняя полоса прозрачная: страница рисуется под
           неё (viewport-fit=cover), и цвет там — фон самого приложения. -->
      <meta-data
          android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
          android:resource="@color/appBackground"/>
      <meta-data
          android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
          android:resource="@color/systemNavBar"/>
      <meta-data
          android:name="androidx.browser.trusted.SPLASH_IMAGE_COLOR"
          android:resource="@color/appBackground"/>
      <meta-data
          android:name="androidx.browser.trusted.FILE_PROVIDER_AUTHORITY"
          android:value="${applicationId}.fileprovider"/>
      <meta-data
          android:name="android.app.shortcuts"
          android:resource="@xml/shortcuts"/>

      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>

      <!-- ссылки на сайт открываются в приложении, а не в браузере -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="https" android:host="${hostName}"/>
      </intent-filter>
    </activity>

    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/filepaths"/>
    </provider>

    <service
        android:name="com.google.androidbrowserhelper.trusted.DelegationService"
        android:exported="true">
      <intent-filter>
        <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE"/>
        <category android:name="android.intent.category.DEFAULT"/>
      </intent-filter>
    </service>

  </application>
</manifest>
