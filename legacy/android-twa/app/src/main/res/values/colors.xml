<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Светлая тема приложения. Это значения по умолчанию: система считает светлую
       тему обычной, а тёмную — ночным вариантом (см. values-night/colors.xml).
       Цвета обязаны совпадать с переменной bg в index.html, иначе на старте видна чужая
       заливка до первой отрисовки страницы. -->
  <color name="appBackground">#F6F4FC</color>
  <!-- Нижняя системная полоса прозрачная: страница уже рисуется под неё
       (viewport-fit=cover), и полоса принимает цвет самого приложения, а не
       зашитый в APK. Так низ следует за темой профиля мгновенно — включая ту,
       которую человек выбрал вручную вопреки системной. -->
  <color name="systemNavBar">#00000000</color>
  <!-- Фирменный цвет иконки запуска. Ночного варианта у него НЕТ намеренно:
       иконка на рабочем столе не должна перекрашиваться вместе с темой системы. -->
  <color name="colorPrimary">#0C0916</color>
</resources>
